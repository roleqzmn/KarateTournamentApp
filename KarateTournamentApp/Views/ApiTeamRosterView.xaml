<UserControl x:Class="KarateTournamentApp.Views.ApiTeamRosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,20,0" Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Drużyny" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Nowa drużyna" Command="{Binding NewTeamCommand}" Padding="8,4" Margin="0,0,0,4"/>
                    <Button Content="Usuń drużynę" Command="{Binding DeleteCommand}" Padding="8,4"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" DisplayMemberPath="Name"/>
            </DockPanel>
            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top">
                    <Label Content="Nazwa drużyny" Target="{Binding ElementName=TeamName}"/>
                    <TextBox x:Name="TeamName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    <Label Content="Płeć" Target="{Binding ElementName=TeamSex}"/>
                    <ComboBox x:Name="TeamSex" ItemsSource="{Binding SexOptions}" SelectedItem="{Binding Sex}" Padding="5"/>
                    <Label Content="Zawodnicy z rejestru" Target="{Binding ElementName=TeamMembers}" Margin="0,8,0,0"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Przesuń w górę" Command="{Binding Roster.MoveUpCommand}" Padding="8,4" Margin="0,0,6,0"/>
                    <Button Content="Przesuń w dół" Command="{Binding Roster.MoveDownCommand}" Padding="8,4" Margin="0,0,6,0"/>
                    <Button Content="Zapisz drużynę" Command="{Binding SaveCommand}" Padding="10,4"/>
                </WrapPanel>
                <ListBox x:Name="TeamMembers" ItemsSource="{Binding Roster.Choices}" SelectedItem="{Binding Roster.SelectedParticipant}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
