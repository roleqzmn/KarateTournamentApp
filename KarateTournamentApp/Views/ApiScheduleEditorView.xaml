<UserControl x:Class="KarateTournamentApp.Views.ApiScheduleEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="620" MinHeight="420">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <DockPanel IsEnabled="{Binding CanEdit}">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Label Content="Liczba mat" Target="{Binding ElementName=MatCount}"/>
                <TextBox x:Name="MatCount" Width="55" Margin="0,0,8,6" VerticalContentAlignment="Center"
                         Text="{Binding MatCountText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Zastosuj" Command="{Binding ApplyMatCountCommand}"/>
                <Button Content="Zapisz plan" Command="{Binding SaveCommand}"/>
                <Button Content="Odrzuć zmiany i odśwież" Command="{Binding ReloadCommand}"/>
                <Button Content="Eksportuj zapisany plan do druku" Command="{Binding ExportCommand}"/>
            </WrapPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Label Content="Mata" Target="{Binding ElementName=MatSelector}"/>
                <ComboBox x:Name="MatSelector" Width="115" ItemsSource="{Binding Mats}" SelectedItem="{Binding SelectedMat}"
                          DisplayMemberPath="Label"/>
                <TextBlock Text="{Binding SelectedMat.Station}" Margin="4,4,14,0"/>
                <Button Content="Zwolnij matę" Command="{Binding RecoverMatCommand}"/>
            </WrapPanel>
            <WrapPanel DockPanel.Dock="Top">
                <ComboBox Width="320" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}"
                          AutomationProperties.Name="Konkurencje bez maty">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} (ID {1})">
                                        <Binding Path="Name"/>
                                        <Binding Path="Id"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Dodaj do kolejki" Command="{Binding AddSlotCommand}"/>
            </WrapPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <WrapPanel>
                    <Button Content="Wcześniej" Command="{Binding MoveUpCommand}"/>
                    <Button Content="Później" Command="{Binding MoveDownCommand}"/>
                    <Button Content="Usuń z kolejki" Command="{Binding RemoveSlotCommand}"/>
                    <ComboBox Width="108" ItemsSource="{Binding Mats}" SelectedItem="{Binding DestinationMat}"
                              DisplayMemberPath="Label" AutomationProperties.Name="Mata docelowa"/>
                    <Button Content="Przenieś do wybranej maty" Command="{Binding MoveToMatCommand}"/>
                </WrapPanel>
                <WrapPanel>
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSlot}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <Label Content="Od" Target="{Binding ElementName=StartsAt}"/>
                    <TextBox x:Name="StartsAt" Width="144" Margin="0,0,8,0" Text="{Binding SelectedSlot.StartsAt, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Do" Target="{Binding ElementName=EndsAt}"/>
                    <TextBox x:Name="EndsAt" Width="144" Margin="0,0,8,0" Text="{Binding SelectedSlot.EndsAt, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Opcjonalnie · RRRR-MM-DD GG:MM" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding SelectedMat.Slots}" SelectedItem="{Binding SelectedSlot}" IsReadOnly="True"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                      SelectionMode="Single" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Konkurencja" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Od" Binding="{Binding StartsAt}" Width="*"/>
                    <DataGridTextColumn Header="Do" Binding="{Binding EndsAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</UserControl>
