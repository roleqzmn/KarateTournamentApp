<UserControl x:Class="KarateTournamentApp.Views.ParticipantResultHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Konkurencja" Binding="{Binding CategoryName}" Width="2*"/>
                <DataGridTextColumn Header="Dyscyplina" Binding="{Binding DisciplineName}" Width="*"/>
                <DataGridTextColumn Header="Miejsce" Binding="{Binding Rank, TargetNullValue=—}"/>
                <DataGridTextColumn Header="Nota końcowa" Binding="{Binding JudgedScore, StringFormat=0.##, TargetNullValue=—}"/>
                <DataGridTextColumn Header="Drużyna" Binding="{Binding TeamName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Brak opublikowanych wyników dla tego zawodnika." TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasResults}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
