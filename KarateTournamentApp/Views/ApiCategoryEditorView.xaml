<UserControl x:Class="KarateTournamentApp.Views.ApiCategoryEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#A52A2A" Margin="0,0,0,8"/>
            <Button Content="Zapisz konkurencję" Command="{Binding SaveCommand}"
                    HorizontalAlignment="Right" Padding="14,6"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nazwa"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Dyscyplina"/>
                        <ComboBox ItemsSource="{Binding Disciplines}" DisplayMemberPath="Key" SelectedValuePath="Value"
                                  SelectedValue="{Binding Discipline}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="Płeć"/>
                        <ComboBox ItemsSource="{Binding SexOptions}" SelectedItem="{Binding Sex}" Margin="0,4,0,0"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Wiek od (opcjonalnie)"/>
                        <TextBox Text="{Binding MinAge, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="Wiek do (opcjonalnie)"/>
                        <TextBox Text="{Binding MaxAge, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="Dopuszczone pasy" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding BeltOptions}" Margin="0,4,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,4,12,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Po zapisaniu konkurencji wybierz Drużyny, aby dodać składy."
                           Visibility="{Binding IsTeamKata, Converter={StaticResource BoolToVisibilityConverter}}"
                           TextWrapping="Wrap"/>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTeamKata}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Skład konkurencji" FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding Roster.Choices}" SelectedItem="{Binding Roster.SelectedParticipant}"
                             Height="190" Margin="0,4,0,6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Przesuń w górę" Command="{Binding Roster.MoveUpCommand}" Padding="8,4" Margin="0,0,6,0"/>
                        <Button Content="Przesuń w dół" Command="{Binding Roster.MoveDownCommand}" Padding="8,4"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
